let bloqueado = false;

function formatarAltura(valor){
  valor = valor.replace(",",".");
  if(valor > 3){
    valor = (valor/100).toFixed(2);
  }
  return parseFloat(valor);
}

function calcularIMC(){

  if(bloqueado){
    document.getElementById('resultado').innerHTML =
      "Clique em REFAZER para calcular novamente 👇";
    return;
  }

  let sexo=document.getElementById('sexo').value;
  let idade=document.getElementById('idade').value;
  let peso=document.getElementById('peso').value;
  let altura=formatarAltura(document.getElementById('altura').value);

  if(!sexo||!idade||!peso||!altura){
    document.getElementById('resultado').innerHTML='Preencha tudo!';
    return;
  }

  // ⏳ efeito carregando
  document.getElementById('resultado').innerHTML = "Calculando seu resultado...";
  document.getElementById('progresso').style.width = "20%";

  setTimeout(() => {

    let imc=(peso/(altura*altura)).toFixed(2);

    let status='';
    let progresso=0;
    let cor = '';

    if(imc < 18.5){
      status='Abaixo do peso';
      progresso=25;
      cor = '#e53935'; // vermelho
    }
    else if(imc < 25){
      status='Peso ideal';
      progresso=50;
      cor = '#2e7d32'; // verde
    }
    else if(imc < 30){
      status='Sobrepeso';
      progresso=75;
      cor = '#fbc02d'; // amarelo
    }
    else{
      status='Obesidade';
      progresso=100;
      cor = '#e53935'; // vermelho
    }

    // aplica barra
    let barra = document.getElementById('progresso');
    barra.style.width = progresso+'%';
    barra.style.background = cor;

    let dica = sexo==='mulher'
    ? 'Cuide da alimentação e equilíbrio hormonal.'
    : 'Foque em massa muscular e controle de gordura.';

    if(idade > 60){
      dica += ' Atenção especial para idosos.';
    }

    document.getElementById('resultado').innerHTML =
    `IMC: ${imc} - ${status}<br>${dica}`;

    // 🔒 trava
    bloqueado = true;
    document.querySelector("button").disabled = true;

  }, 1500);
}

function refazer(){

  document.getElementById('sexo').value = "";
  document.getElementById('idade').value = "";
  document.getElementById('peso').value = "";
  document.getElementById('altura').value = "";
  document.getElementById('resultado').innerHTML = "";

  let barra = document.getElementById('progresso');
  barra.style.width = "0%";
  barra.style.background = "#2e7d32"; // volta verde padrão

  bloqueado = false;

  document.querySelector("button").disabled = false;

  // 💰 força nova impressão de anúncio
  location.reload();
}





